# Copy to `.env` and override as needed. All values are OPTIONAL — the demo runs out of the box.

# Express Checkout — override the public merchant-application token used to init the express element.
# A default token (from the checkout-web-stripe express.html sample) is baked in, so this is only
# needed to use a different token. The backend validates clientId server-side; it is not a secret.
# VITE_EXPRESS_CLIENT_ID=

# Local wallet-testing knobs (see README "Express Checkout Demo"):
# EXPRESS_HTTPS=true
# The dev-server proxy target for /opg-proxy. checkout-web derives the OPG express URL from `env`, but
# the browser cannot call the OPG host directly from https://localhost (no CORS), so the demo's fetch
# shim reroutes GET /pci/v1/express here. Change this when pointing at another OPG env.
# OPG_PROXY_TARGET=https://api.checkout.integration.oscato.com

# OpenTelemetry is OFF by default. To enable it, set BOTH of these: the flag and your OWN collector
# endpoint. No collector URL is baked into the source.
# VITE_ENABLE_TELEMETRY=true
# VITE_TELEMETRY_ENDPOINT=https://your-otel-collector.example.com
